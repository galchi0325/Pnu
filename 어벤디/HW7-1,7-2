// HW7-1 

// 핀 번호 설정
int ledPins[] = {2, 3, 4, 5}; // LED 핀 배열
int photoPin = A0;           // 조도센서 핀 (A0)
int ledCount = 4;            // LED 개수

// 기준값
const int BRIGHT_THRESHOLD = 150; // 밝음/어두움 기준 (150 미만이면 '밝음')

void setup() {
  Serial.begin(9600); // 시리얼 모니터 시작 (값 확인용)
  
  // 4개의 LED 핀을 모두 OUTPUT으로 설정
  for (int i = 0; i < ledCount; i++) {
    pinMode(ledPins[i], OUTPUT);
  }
}

void loop() {
  // 1. 조도센서 값 읽기 (0 ~ 1023)
  int lightValue = analogRead(photoPin);

  // 2. 시리얼 모니터에 현재 값 출력
  Serial.print("Light Value: ");
  Serial.println(lightValue);

  int numLEDsToTurnOn = 0; // 켤 LED의 개수

  // 3. 로직 처리
  if (lightValue < BRIGHT_THRESHOLD) {
    // 150 미만이면 '밝음' -> LED 모두 끄기
    numLEDsToTurnOn = 0;
  } else {
    // 150 이상이면 '어두움' 
    // 값을 1~4 범위로 매핑합니다.
    // (1023 - 150) = 873. 873 / 4 = 218.25
    
    if (lightValue < BRIGHT_THRESHOLD + 218) {       // 150 ~ 367
      numLEDsToTurnOn = 1;
    } else if (lightValue < BRIGHT_THRESHOLD + 2 * 218) { // 368 ~ 585
      numLEDsToTurnOn = 2;
    } else if (lightValue < BRIGHT_THRESHOLD + 3 * 218) { // 586 ~ 803
      numLEDsToTurnOn = 3;
    } else { // 804 ~ 1023 (가장 어두움)
      numLEDsToTurnOn = 4;
    }
  }

  // 4. LED 점등 제어
  for (int i = 0; i < ledCount; i++) {
    if (i < numLEDsToTurnOn) {
      digitalWrite(ledPins[i], HIGH); // 켤 개수만큼 앞에서부터 켜기
    } else {
      digitalWrite(ledPins[i], LOW);  // 나머지는 끄기
    }
  }

  delay(100); // 0.1초 대기
}
// HW 7-2

// 핀 번호 설정
int potPin = A1;       // 가변저항 핀 (A1)
int speakerPin = 8;    // 스피커 핀 (PWM 가능핀)

// 음계 주파수 배열 (9단계: 무음, 도4~도5)
// 인덱스: 0     1    2    3    4    5    6    7    8
int frequencies[] = {
  0,  // 무음
  262, // 도 (C4)
  294, // 레 (D4)
  330, // 미 (E4)
  349, // 파 (F4)
  392, // 솔 (G4)
  440, // 라 (A4)
  494, // 시 (B4)
  523  // 도 (C5)
};

int currentLevel = -1; // 현재 연주 중인 레벨을 저장

void setup() {
  Serial.begin(9600); // 시리얼 모니터 시작 (값 확인용)
  pinMode(speakerPin, OUTPUT); // 스피커 핀을 OUTPUT으로 설정
}

void loop() {
  // 1. 가변저항 값 읽기 (0 ~ 1023)
  int potValue = analogRead(potPin);

  // 2. 값을 9단계(0~8)로 매핑
  int level = map(potValue, 0, 1024, 0, 9); // 0~1023 -> 0~8

  // 3. 시리얼 모니터에 값 출력
  Serial.print("Pot Value: ");
  Serial.print(potValue);
  Serial.print(", Level: ");
  Serial.print(level);
  Serial.print(", Frequency: ");
  Serial.println(frequencies[level]);

  // 4. 레벨이 변경되었을 때만 스피커 제어
  if (level != currentLevel) {
    currentLevel = level; // 현재 레벨 업데이트
    
    if (level == 0) {
      // 레벨이 0이면 '무음'
      noTone(speakerPin);
    } else {
      // 0이 아니면 해당 주파수로 연주
      tone(speakerPin, frequencies[level]);
    }
  }

  delay(50); // 0.05초 대기 (값 안정화)
}

