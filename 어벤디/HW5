// HW5 

// LED 핀 번호
int ledPins[4] = {2, 3, 4, 5};

// 각 LED의 시작 밝기 오프셋
int startValues[4] = {0, 63, 127, 191};

void setup() {
  // 핀모드 설정
  for (int i = 0; i < 4; i++) {
    pinMode(ledPins[i], OUTPUT);
  }
}

void loop() {
  // 밝기가 0 → 255까지 증가
  for (int value = 0; value <= 255; value++) {
    for (int i = 0; i < 4; i++) {
      int brightness = (startValues[i] + value) % 256; // 오프셋 적용
      analogWrite(ledPins[i], brightness);
    }
    delay(10); // 밝기 변화 속도 조절
  }

  // 255 이후 즉시 0으로 초기화 (다시 0부터 시작)
  for (int i = 0; i < 4; i++) {
    analogWrite(ledPins[i], 0);
  }
}
