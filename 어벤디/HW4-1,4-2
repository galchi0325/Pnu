//HW 4-1
String words[5];
int count = 0;

void setup() {
  Serial.begin(9600);
  Serial.println("Enter 5 words:");
}

void loop() {
  if (Serial.available() > 0) {
    words[count] = Serial.readStringUntil('\n');
    words[count].trim();
    Serial.print("Enter the ");
    Serial.print(count + 1);
    Serial.println("th Word --> " + words[count]);
    count++;
  }

  if (count == 5) {
    for (int i = 0; i < 4; i++) {
      for (int j = i + 1; j < 5; j++) {
        if (words[i] > words[j]) {
          String temp = words[i];
          words[i] = words[j];
          words[j] = temp;
        }
      }
    }
    Serial.println("After Sorting:");
    for (int i = 0; i < 5; i++) {
      Serial.println(words[i]);
    }
    Serial.println();
    count = 0;
  }
}
//HW4-2
const int ledPins[4] = {2, 3, 4, 5};
const int buttonPin = 14;

int direction = 1;
int currentLED = 0;
unsigned long prevMillis = 0;
const long interval = 500;

void setup() {
  for (int i = 0; i < 4; i++) {
    pinMode(ledPins[i], OUTPUT);
  }
  pinMode(buttonPin, INPUT);
}

void loop() {
  if (digitalRead(buttonPin) == HIGH) {
    delay(200);
    if (digitalRead(buttonPin) == HIGH) {
      direction = -direction;
    }
  }

  unsigned long currentMillis = millis();
  if (currentMillis - prevMillis >= interval) {
    prevMillis = currentMillis;
    for (int i = 0; i < 4; i++) {
      digitalWrite(ledPins[i], LOW);
    }
    digitalWrite(ledPins[currentLED], HIGH);
    currentLED += direction;
    if (currentLED > 3) currentLED = 0;
    if (currentLED < 0) currentLED = 3;
  }
}

