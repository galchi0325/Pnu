//HW9-1
#include <Servo.h> // 서보 모터 라이브러리 포함

Servo myServo;  // 서보 객체 생성
int angle = 90; // 서보의 현재 각도를 저장할 변수 (초기값 90도)

const int buttonPinUp = 14;   // 각도 증가 버튼 핀
const int buttonPinDown = 15; // 각도 감소 버튼 핀

void setup() {
  // 서보 모터를 9번 핀에 연결 (PWM 기능이 있는 핀)
  // 핀 번호는 실제 연결에 맞게 변경 가능합니다.
  myServo.attach(9); 
  
  // 버튼 핀을 입력으로 설정
  pinMode(buttonPinUp, INPUT);   
  pinMode(buttonPinDown, INPUT); 
  
  // 서보를 초기 각도(90도)로 이동
  myServo.write(angle); 
}

void loop() {
  // 14번 버튼 (증가)이 눌렸는지 확인 (풀다운이므로 HIGH 신호 감지)
  if (digitalRead(buttonPinUp) == HIGH) {
    angle += 10; // 각도를 10도 증가
  }

  // 15번 버튼 (감소)이 눌렸는지 확인
  if (digitalRead(buttonPinDown) == HIGH) {
    angle -= 10; // 각도를 10도 감소
  }

  // 각도의 범위를 0도에서 180도 사이로 제한
  // (서보 모터의 물리적 한계를 넘지 않도록 함)
  angle = constrain(angle, 0, 180);

  // 계산된 최종 각도로 서보 모터 위치를 업데이트
  myServo.write(angle);

  // 버튼이 한 번 눌릴 때 여러 번 인식되는 것을 방지 (디바운싱)
  // 너무 빨리 연속으로 눌리는 것을 막고 서보가 움직일 시간을 줍니다.
  delay(150); 
}

//HW9-2

// L293D 모터 드라이버 연결 핀
const int enablePin = 9; // 속도 제어 (PWM 핀: 3, 5, 6, 9, 10, 11)
const int in1Pin = 8;    // 모터 방향 제어 1
const int in2Pin = 7;    // 모터 방향 제어 2

// 버튼 핀
const int buttonPin = 14;

// 모터 상태를 저장할 변수
// 0: 정지
// 1: 1/2 속도
// 2: 최대 속도
int motorState = 0; 

// 버튼 디바운싱(Debouncing)을 위한 변수
int lastButtonState = LOW; // 버튼의 이전 상태

void setup() {
  // 모터 핀들을 출력으로 설정
  pinMode(enablePin, OUTPUT);
  pinMode(in1Pin, OUTPUT);
  pinMode(in2Pin, OUTPUT);

  // 버튼 핀을 입력으로 설정 (풀다운 저항은 외부에 연결)
  pinMode(buttonPin, INPUT);

  // 모터 정지 상태로 시작
  digitalWrite(in1Pin, LOW);
  digitalWrite(in2Pin, LOW);
  analogWrite(enablePin, 0);
}

void loop() {
  // 현재 버튼 상태를 읽어옴
  int currentButtonState = digitalRead(buttonPin);

  // 버튼이 '눌린 순간'을 감지 (이전엔 LOW, 지금은 HIGH)
  // 이렇게 하면 버튼을 꾹 누르고 있어도 1번만 인식됩니다.
  if (currentButtonState == HIGH && lastButtonState == LOW) {
    
    // motorState 값을 0 -> 1 -> 2 -> 0 ... 순서로 변경
    motorState = (motorState + 1) % 3;

    // 새로운 상태에 따라 모터 속도 업데이트
    updateMotorSpeed(motorState);
    
    // 버튼이 눌린 후 잠시 딜레이를 주어 바운싱 방지
    delay(50); 
  }

  // 현재 버튼 상태를 '이전 상태'로 저장
  lastButtonState = currentButtonState;
}

// 모터 속도를 설정하는 함수
void updateMotorSpeed(int state) {
  if (state == 0) {
    // 상태 0: 정지 (Brake)
    digitalWrite(in1Pin, LOW);
    digitalWrite(in2Pin, LOW);
    analogWrite(enablePin, 0); // PWM 0
  } else {
    // 상태 1 또는 2: 정회전 방향 설정
    digitalWrite(in1Pin, HIGH);
    digitalWrite(in2Pin, LOW);
    
    if (state == 1) {
      // 상태 1: 1/2 속도
      analogWrite(enablePin, 127); // PWM 127 (최대의 약 절반)
    } else if (state == 2) {
      // 상태 2: 최대 속도
      analogWrite(enablePin, 255); // PWM 255 (최대)
    }
  }
}
